[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    venv,
    env,
    .venv
ignore =
    # Line too long (handled by black)
    E501,
    # Line break before binary operator (black compatibility)
    W503,
per-file-ignores =
    __init__.py:F401

